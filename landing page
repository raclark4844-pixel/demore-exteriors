            box-shadow: 0 6px 15px rgba(0,0,0,0.4);
            text-decoration: none;
            z-index: 1000;
            transition: transform 0.3s;
        }
        .call-now:hover { transform: scale(1.1); }

        footer {
            background: var(--dark-bg);
            color: white;
            text-align: center;
            padding: 30px 20px;
        }

        @media (max-width: 768px) {
            h1 { font-size: 2.5rem; }
            header { padding: 80px 15px 60px; }
        }
