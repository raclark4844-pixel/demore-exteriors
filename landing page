            gap: 25px;
        }
        .service-card {
            background: #f9f9f9;
            padding: 25px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        .service-card:hover { transform: translateY(-10px); }

        .gallery-grid {
