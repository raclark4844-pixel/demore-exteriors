{
  "name": "ImprovementRecommendation",
  "type": "object",
  "properties": {
    "recommendationId": {
      "type": "string",
      "description": "Stable human-readable recommendation reference"
    },
    "dedupeKey": {
      "type": "string",
      "description": "Deterministic theme/target key used to merge repeat findings"
    },
    "title": {
      "type": "string",
      "description": "Short recommendation title"
    },
    "description": {
      "type": "string",
      "description": "Full recommendation text"
    },
    "category": {
      "type": "string",
      "description": "Primary audit category such as SEO, GEO, AEO, CRO, UX"
    },
    "theme": {
      "type": "string",
      "description": "Normalized improvement theme"
    },
    "targetPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known site paths mentioned by the recommendation"
    },
    "sourceChangeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceAuditRunIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceResultIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "impactScore": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "effortScore": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "riskScore": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "priorityScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "occurrenceCount": {
      "type": "number",
      "minimum": 1,
      "default": 1
    },
    "ownerDecision": {
      "type": "string",
      "enum": [
        "NEW",
        "FIX_NOW",
        "REVIEW",
        "IGNORE"
      ],
      "default": "NEW"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "APPROVED_FOR_PLANNING",
        "UNDER_REVIEW",
        "IGNORED",
        "RESOLVED"
      ],
      "default": "OPEN"
    },
    "firstSeenAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastSeenAt": {
      "type": "string",
      "format": "date-time"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisionNotes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recommendationId",
    "dedupeKey",
    "title",
    "category",
    "priorityScore"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}