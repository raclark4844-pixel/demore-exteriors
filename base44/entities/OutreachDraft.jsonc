{
  "name": "OutreachDraft",
  "type": "object",
  "properties": {
    "dedupe_key": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "review",
        "storm"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ]
    },
    "destination": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "exported",
        "sent",
        "cancelled"
      ],
      "default": "draft"
    },
    "storm_id": {
      "type": "string"
    }
  },
  "required": [
    "dedupe_key",
    "kind",
    "channel",
    "message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}