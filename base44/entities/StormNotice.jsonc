{
  "name": "StormNotice",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "instruction": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "archived"
      ],
      "default": "published"
    },
    "affected_zips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "source_id",
    "slug",
    "title",
    "county",
    "source_url"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}