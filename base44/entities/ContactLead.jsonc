{
  "name": "ContactLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the person requesting an estimate"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "address": {
      "type": "string",
      "description": "Property address"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "roofing",
        "siding",
        "gutters",
        "storm_damage",
        "windows",
        "doors",
        "decks",
        "multiple",
        "other"
      ],
      "description": "Type of service requested"
    },
    "insurance_claim_filed": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "not_sure"
      ],
      "description": "Whether an insurance claim has already been filed"
    },
    "claim_carrier": {
      "type": "string",
      "description": "Insurance carrier, when provided"
    },
    "claim_number": {
      "type": "string",
      "description": "Insurance claim number, when provided"
    },
    "date_of_loss": {
      "type": "string",
      "description": "Reported date of loss or storm date"
    },
    "adjuster_name": {
      "type": "string",
      "description": "Adjuster name, when provided"
    },
    "adjuster_phone": {
      "type": "string",
      "description": "Adjuster phone, when provided"
    },
    "adjuster_email": {
      "type": "string",
      "description": "Adjuster email, when provided"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ],
      "default": "en",
      "description": "Preferred intake language"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "website",
        "chat",
        "ai_phone",
        "damage_check",
        "satellite_estimate",
        "storm_event",
        "other"
      ],
      "default": "website",
      "description": "Source that created the lead"
    },
    "active_leak": {
      "type": "boolean",
      "default": false,
      "description": "True when the caller reports water actively entering the property"
    },
    "call_summary": {
      "type": "string",
      "description": "Short AI phone-agent summary of the call"
    },
    "transcript_url": {
      "type": "string",
      "description": "Transcript URL or transcript reference from the phone provider"
    },
    "message": {
      "type": "string",
      "description": "Additional details or message"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "scheduled",
        "completed"
      ],
      "default": "new",
      "description": "Lead status"
    },
    "estimate_request_id": {
      "type": "string",
      "description": "Random submission token used to recover an estimate after a retry."
    },
    "estimate_data": {
      "type": "object",
      "description": "Server-calculated preliminary estimate, measurement source, assumptions, and version. Not a bid."
    },
    "contact_consent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Consent to contact about the estimate."
    },
    "owner_notification_id": {
      "type": "string",
      "description": "Email provider acceptance ID for the owner notification."
    }
  },
  "required": [
    "name",
    "phone"
  ]
}
