{
  "name": "ProjectPhoto",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title / caption for the project photo"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the project image"
    },
    "category": {
      "type": "string",
      "enum": [
        "Roofing",
        "Siding",
        "Gutters",
        "Decks & Outdoor Living",
        "Windows",
        "Doors",
        "Storm Damage",
        "Other"
      ],
      "default": "Other",
      "description": "Service category the photo belongs to"
    },
    "description": {
      "type": "string",
      "description": "Short description of the project"
    },
    "project_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the project (YYYY-MM-DD)"
    },
    "facebook_post_url": {
      "type": "string",
      "description": "Link back to the original Facebook post"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower first)"
    }
  },
  "required": [
    "title",
    "image_url"
  ]
}