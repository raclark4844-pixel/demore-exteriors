{
  "name": "Owner Approval Finalizer",
  "description": "When Ryan Bomer approves an OWNER approval in AI Control, runs the Evaluate Gate for that Change ID and builds the Base44 Implementation Package if every required approval is satisfied.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "AgentApprovals",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.approvalType == \"OWNER\" and .trigger.data.status == \"APPROVED\" and .trigger.old_data.status != \"APPROVED\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "owner_approval_finalizer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "finalize_job": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "finalizeApprovedJob",
            "args": {
              "approval_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Finalize approved job",
            "description": "Gate + build implementation package"
          }
        }
      }
    ]
  }
}