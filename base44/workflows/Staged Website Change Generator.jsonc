{
  "name": "Staged Website Change Generator",
  "description": "When a Fix Now implementation passes staging preflight, automatically generate the bounded GitHub branch and pull request. Production remains untouched.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "StagedWebsiteChange",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"READY_TO_STAGE\" and .trigger.old_data.status != .trigger.data.status }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "staged_website_change_generator",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "stage_change": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stageApprovedWebsiteChange",
            "args": {
              "staged_change_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate staging PR",
            "description": "Generate a bounded patch, branch, and pull request from the owner-approved implementation package"
          }
        }
      }
    ]
  }
}