{
  "name": "Staged Website Change Preflight",
  "description": "When an approved Improvement Priority Engine planning job creates an implementation package, run GitHub/Vercel staging preflight without touching production.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ImplementationQueue",
      "events": [
        "create"
      ]
    },
    "condition": null
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "staged_website_change_preflight",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "prepare_stage": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "prepareStagedWebsiteChange",
            "args": {
              "implementation_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Prepare staged website change",
            "description": "Validate owner gate, GitHub OAuth, and repository baseline before branch/PR staging"
          }
        }
      }
    ]
  }
}